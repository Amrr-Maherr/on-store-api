        <mxCell id="mod-route-arch" value="&lt;table style=&quot;font-size:9px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;background:#FDEBD0;border:1px solid #F5CBA7;border-radius:3px;color:#CA6F1E;&quot;&gt;route.ts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;color:#999;&quot;&gt;&amp;rarr;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:3px;color:#1E8449;&quot;&gt;controller.ts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;color:#999;&quot;&gt;&amp;rarr;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;background:#D6EAF8;border:1px solid #AED6F1;border-radius:3px;color:#2471A3;&quot;&gt;service.ts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;color:#999;&quot;&gt;&amp;rarr;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;background:#E8F8F5;border:1px solid #A3E4D7;border-radius:3px;color:#148F77;&quot;&gt;model.ts&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;color:#999;&quot;&gt;&amp;rarr;&lt;/td&gt;&lt;td style=&quot;padding:3px 8px;background:#E8F6F3;border:1px solid #A2D9CE;border-radius:3px;color:#117864;&quot;&gt;MongoDB&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
