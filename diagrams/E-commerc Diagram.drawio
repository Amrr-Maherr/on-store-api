        <mxCell id="flow-label" value="&lt;b&gt;REQUEST FLOW&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#2C3E50;fontSize=12;" vertex="1" parent="1">
