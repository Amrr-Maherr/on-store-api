        <mxCell id="db-models" value="&lt;table style=&quot;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Users&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Products&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Brands&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Categories&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Cart&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Orders&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Payments&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Coupons&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Ratings&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Reviews&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;background:#D5F5E3;border:1px solid #ABEBC6;border-radius:4px;color:#1E8449;&quot;&gt;Wishlist&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
